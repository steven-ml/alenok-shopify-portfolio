{%- comment -%}
  ─────────────────────────────────────────────────────────────────────────────
  Alenok — Portfolio excerpt · Before / After grid section (Liquid + schema)
  Simplified from the production implementation for demonstration purposes.
  © 2026 Fredy Espinoza — All rights reserved. See LICENSE.
  ─────────────────────────────────────────────────────────────────────────────
  What this shows
  • Dynamic setting keys: section.settings[key] built with `append`, so one loop
    renders N image pairs instead of copy-pasting markup N times
  • Empty-safe rendering: missing images never output broken <img> tags
  • Responsive images through `image_url: width:` (Shopify CDN resizing)
  • Honest UX copy: an explicit disclaimer next to health-related visuals
{%- endcomment -%}

<section class="aln-scope ba-section">
  <div class="aln-container">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="ba-row">
      {%- for i in (1..3) -%}
        {%- assign before_key = 'ba_before_' | append: i -%}
        {%- assign after_key  = 'ba_after_'  | append: i -%}
        {%- assign before_img = section.settings[before_key] -%}
        {%- assign after_img  = section.settings[after_key] -%}

        {%- if before_img != blank or after_img != blank -%}
          <figure class="ba-pair">
            <div class="ba-card">
              <span class="ba-tag ba-tag--before">Before</span>
              {%- if before_img != blank -%}
                {%- assign before_alt = before_img.alt | default: 'Before' -%}
                {{ before_img | image_url: width: 400 | image_tag: loading: 'lazy', alt: before_alt }}
              {%- endif -%}
            </div>
            <div class="ba-card">
              <span class="ba-tag ba-tag--after">After</span>
              {%- if after_img != blank -%}
                {%- assign after_alt = after_img.alt | default: 'After' -%}
                {{ after_img | image_url: width: 400 | image_tag: loading: 'lazy', alt: after_alt }}
              {%- endif -%}
            </div>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="ba-disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Before / After grid",
  "settings": [
    { "type": "text",         "id": "heading",     "label": "Heading" },
    { "type": "image_picker", "id": "ba_before_1", "label": "Pair 1 — Before" },
    { "type": "image_picker", "id": "ba_after_1",  "label": "Pair 1 — After" },
    { "type": "image_picker", "id": "ba_before_2", "label": "Pair 2 — Before" },
    { "type": "image_picker", "id": "ba_after_2",  "label": "Pair 2 — After" },
    { "type": "image_picker", "id": "ba_before_3", "label": "Pair 3 — Before" },
    { "type": "image_picker", "id": "ba_after_3",  "label": "Pair 3 — After" },
    { "type": "textarea",     "id": "disclaimer",  "label": "Disclaimer",
      "default": "Illustrative image. Individual results vary." }
  ],
  "presets": [{ "name": "Before / After grid" }]
}
{% endschema %}
